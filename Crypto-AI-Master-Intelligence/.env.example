# Copy to .env and fill only the keys you have.
# Missing keys are valid: the app must run and mark those providers as missing_key.

CAMI_HOST=127.0.0.1
CAMI_PORT=8787
CAMI_DATABASE_URL=sqlite:///./data/cami.db
CAMI_LOG_LEVEL=INFO
CAMI_SCHEDULER_ENABLED=true

# Optional. Public market endpoints work without these.
BINANCE_API_KEY=
BINANCE_API_SECRET=
COINGECKO_API_KEY=
GOPLUS_APP_KEY=
GITHUB_TOKEN=
FOOTBALL_DATA_API_KEY=
THESPORTSDB_API_KEY=3

# Notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Never put private keys or seed phrases here.
